# No secrets required for offline preview development.
# npm run dev / npm run build:preview always use empty states until verified data is connected.
VITE_SUPABASE_URL=https://preview.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=preview-public-placeholder
# Production public configuration remains managed by Lovable / deployment settings.
# Never put service-role, database, admin, Stripe or Resend secrets in VITE_* variables.
